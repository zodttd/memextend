{
  "name": "memextend",
  "version": "0.3.5",
  "private": true,
  "description": "Extend your AI coding assistant's memory. Free, local, private.",
  "author": "ZodTTD LLC",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "clean": "rm -rf packages/*/dist packages/adapters/*/dist apps/*/dist",
    "version:bump": "node scripts/bump-version.js",
    "version:sync": "node scripts/sync-version.js",
    "publish:all": "node scripts/publish.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
